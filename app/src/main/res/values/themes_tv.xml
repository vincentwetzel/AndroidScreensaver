<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TV-optimized theme for NVidia Shield and other Android TV devices -->
    <style name="Theme.AndroidScreensaver.TV" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color - optimized for dark TV environments -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/background_tv</item>
        <!-- Background - dark for TV -->
        <item name="android:windowBackground">@color/background_tv</item>
        <!-- Text colors for TV -->
        <item name="android:textColorPrimary">@color/text_primary_tv</item>
        <item name="android:textColorSecondary">@color/text_secondary_tv</item>
    </style>
</resources>
