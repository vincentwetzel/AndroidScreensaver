<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_tv"
    android:padding="48dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tv_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/your_sources"
        android:textAppearance="?attr/textAppearanceDisplayLarge"
        android:textColor="@color/text_primary_tv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tv_sources_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sources_connected_subtitle"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/text_secondary_tv"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_header"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Connected sources container - populated dynamically -->
    <LinearLayout
        android:id="@+id/connected_sources_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_sources_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Add Sources Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_sources"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/add_sources"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:paddingVertical="20dp"
        android:layout_marginTop="16dp"
        app:icon="@android:drawable/ic_input_add"
        app:iconSize="28dp"
        app:layout_constraintTop_toBottomOf="@id/connected_sources_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Activation Card for TV -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_activate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:cardBackgroundColor="@color/card_background_tv"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/btn_add_sources"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activate Screensaver"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/text_primary_tv"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select this app as your device's screensaver, then pick photo sources below."
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/text_secondary_tv"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_activate_screensaver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open Screensaver Settings"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:paddingVertical="20dp"
                app:icon="@android:drawable/ic_menu_preferences"
                app:iconSize="28dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Settings Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:paddingVertical="24dp"
        android:layout_marginTop="16dp"
        app:icon="@drawable/ic_settings"
        app:iconSize="32dp"
        app:layout_constraintTop_toBottomOf="@id/card_activate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
