<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_tv"
    android:padding="48dp">

    <!-- Header - Larger for TV -->
    <TextView
        android:id="@+id/tv_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_sources"
        android:textAppearance="?attr/textAppearanceDisplayLarge"
        android:textColor="@color/text_primary_tv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Google Drive Card - Larger for TV -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_google_drive"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:cardBackgroundColor="@color/card_background_tv"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="32dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_source_google_drive"
                android:contentDescription="@string/source_google_drive"
                android:layout_marginEnd="32dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_google_drive"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="@color/text_primary_tv" />

                <TextView
                    android:id="@+id/status_google_drive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/not_authenticated"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/text_secondary_tv" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_google_drive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="1.5"
                android:scaleY="1.5" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Gallery Card - Larger for TV -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_gallery"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:cardBackgroundColor="@color/card_background_tv"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/card_google_drive"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="32dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_source_gallery"
                android:contentDescription="@string/source_gallery"
                android:layout_marginEnd="32dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_gallery"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="@color/text_primary_tv" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device photos"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/text_secondary_tv" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_gallery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="1.5"
                android:scaleY="1.5" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Activation Card for TV -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_activate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:cardBackgroundColor="@color/card_background_tv"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/card_gallery"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activate Screensaver"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/text_primary_tv"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select this app as your device's screensaver, then pick photo sources below."
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/text_secondary_tv"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_activate_screensaver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open Screensaver Settings"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:paddingVertical="20dp"
                app:icon="@android:drawable/ic_menu_preferences"
                app:iconSize="28dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Settings Button - Larger for TV -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:paddingVertical="24dp"
        android:layout_marginTop="16dp"
        app:icon="@drawable/ic_settings"
        app:iconSize="32dp"
        app:layout_constraintTop_toBottomOf="@id/card_activate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
