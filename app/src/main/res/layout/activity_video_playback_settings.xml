<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Audio Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/radio_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/radio_mute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mute" />

            <RadioButton
                android:id="@+id/radio_system_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use System Volume" />

            <RadioButton
                android:id="@+id/radio_custom_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use Custom Volume" />

        </RadioGroup>

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:value="75"
            android:enabled="false"
            android:layout_marginBottom="16dp" />

        <!-- Playback Behavior -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Playback Behavior"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show playback controls"
            android:checked="false"
            android:layout_marginBottom="16dp" />

        <!-- Max Video Duration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Min Video Duration"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_min_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Max Video Duration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Max Video Duration"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_max_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- No save button needed - all settings auto-save -->

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
