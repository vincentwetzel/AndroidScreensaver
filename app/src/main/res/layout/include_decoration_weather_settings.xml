<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Position -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Position"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- Use Device Location -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_use_device_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Use Device Location"
        android:checked="true"
        android:layout_marginBottom="16dp" />

    <!-- Manual Location -->
    <LinearLayout
        android:id="@+id/layout_manual_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manual Location (coming soon)"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

    <!-- Temperature Unit -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Temperature Unit"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_temp_unit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- Icon Style -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Icon Style"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_icon_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- Widget Background -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Widget Background"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_widget_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- Font Size -->
    <TextView
        android:id="@+id/label_font_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Font Size (24sp)"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_font_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="8"
        android:valueTo="72"
        android:value="24"
        android:stepSize="1"
        android:layout_marginBottom="16dp" />

    <!-- Animation -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Animation"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_animation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- Pulse Speed (visible only when animation is Pulse) -->
    <LinearLayout
        android:id="@+id/layout_pulse_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pulse Speed"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_pulse_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- Opacity -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Opacity"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:value="100"
        android:stepSize="5"
        android:layout_marginBottom="16dp" />

    <!-- Pulse Min Opacity -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pulse Min Opacity"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_pulse_min_opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:value="60"
        android:stepSize="5"
        android:layout_marginBottom="16dp" />

    <!-- Pulse Max Opacity -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pulse Max Opacity"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_pulse_max_opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:value="100"
        android:stepSize="5"
        android:layout_marginBottom="16dp" />

</LinearLayout>
