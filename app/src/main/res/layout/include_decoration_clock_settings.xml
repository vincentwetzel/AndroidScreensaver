<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Position -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Position"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- Clock Format -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clock Format"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_format"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- Show Seconds -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_show_seconds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show Seconds"
        android:layout_marginBottom="16dp" />

    <!-- Font Size -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Font Size"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_font_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- Background -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Background"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- Animation -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Animation"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_animation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- Pulse Speed (visible only when animation is Pulse) -->
    <LinearLayout
        android:id="@+id/layout_pulse_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pulse Speed"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_pulse_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- Opacity -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Opacity"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:value="100"
        android:stepSize="5"
        android:layout_marginBottom="16dp" />

    <!-- Pulse Min Opacity -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pulse Min Opacity"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_pulse_min_opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:value="60"
        android:stepSize="5"
        android:layout_marginBottom="16dp" />

    <!-- Pulse Max Opacity -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pulse Max Opacity"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_pulse_max_opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:value="100"
        android:stepSize="5"
        android:layout_marginBottom="16dp" />

</LinearLayout>
