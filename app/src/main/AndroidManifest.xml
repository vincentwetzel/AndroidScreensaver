<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- Location for weather -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    
    <!-- Foreground service for screensaver -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    
    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- TV-specific features (optional) -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".ScreensaverApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_settings"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidScreensaver"
        tools:targetApi="31">
        
        <!-- Main Activity -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AndroidScreensaver">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- TV Leanback launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- DreamService (Screensaver) -->
        <service
            android:name=".dream.PhotoScreensaverService"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        
        <!-- Dream Settings Activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/screensaver_settings"
            android:theme="@style/Theme.AndroidScreensaver.Settings" />
        
        <!-- Source Authentication Activity -->
        <activity
            android:name=".ui.sources.GoogleDriveAuthActivity"
            android:exported="false"
            android:label="@string/source_auth" />

        <!-- Dropbox Authentication Activity -->
        <activity
            android:name=".ui.sources.DropboxAuthActivity"
            android:exported="false"
            android:label="Dropbox Authentication" />
        
        <!-- OneDrive Authentication Activity -->
        <activity
            android:name=".ui.sources.OneDriveAuthActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Photo Browser Activity -->
        <activity
            android:name=".ui.sources.FolderBrowserActivity"
            android:exported="false"
            android:label="@string/browse_photos"
            android:theme="@style/Theme.AndroidScreensaver.Settings.NoActionBar" />

        <!-- Gallery Folder Browser Activity -->
        <activity
            android:name=".ui.sources.GalleryFolderBrowserActivity"
            android:exported="false"
            android:label="Browse Gallery"
            android:theme="@style/Theme.AndroidScreensaver.Settings.NoActionBar" />
        
        <!-- Dream Settings Activity -->
        <activity
            android:name=".ui.settings.ScreensaverSettingsActivity"
            android:exported="true"
            android:label="@string/screensaver_settings"
            android:theme="@style/Theme.AndroidScreensaver.Settings" />

        <!-- Schedule Settings Activity -->
        <activity
            android:name=".ui.settings.ScheduleSettingsActivity"
            android:exported="false"
            android:label="Schedule Settings"
            android:theme="@style/Theme.AndroidScreensaver.Settings" />

        <!-- Photo Information Settings Activity -->
        <activity
            android:name=".ui.settings.PhotoInfoSettingsActivity"
            android:exported="false"
            android:label="Photo Information"
            android:theme="@style/Theme.AndroidScreensaver.Settings" />

        <!-- Video Playback Settings Activity -->
        <activity
            android:name=".ui.settings.VideoPlaybackSettingsActivity"
            android:exported="false"
            android:label="Video Playback Settings"
            android:theme="@style/Theme.AndroidScreensaver.Settings" />

        <!-- About Activity -->
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false"
            android:label="@string/about"
            android:theme="@style/Theme.AndroidScreensaver.Settings" />

        <!-- Debug Settings Activity -->
        <activity
            android:name=".ui.settings.DebugSettingsActivity"
            android:exported="false"
            android:label="Debug Settings"
            android:theme="@style/Theme.AndroidScreensaver.Settings" />

        <!-- Decoration Settings Activity -->
        <activity
            android:name=".ui.settings.DecorationSettingsActivity"
            android:exported="false"
            android:label="Customize Decorations"
            android:theme="@style/Theme.AndroidScreensaver.Settings" />

        <!-- Screensaver Preview Activity (for testing without screen timeout) -->
        <activity
            android:name=".ui.ScreensaverPreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.AndroidScreensaver" />

        <!-- Dropbox Authentication Activity -->
        <activity
            android:name="com.dropbox.core.android.AuthActivity"
            android:configChanges="orientation|keyboard"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <data
                    android:scheme="db-${DROPBOX_APP_KEY}" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Callback for OAuth2 flows -->
        <activity
            android:name=".ui.sources.OAuthCallbackActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
        </activity>

        <!-- MSAL Browser Tab Activity -->
        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="msauth"
                    android:host="com.vincentwetzel.androidscreensaver.debug"
                    android:path="/mFva8cfSlQYJ8+g3obMzz+A0xYU=" />
            </intent-filter>
        </activity>
        
        <!-- Boot receiver to reschedule alarms -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Service to set alarms -->
        <service android:name=".service.ScheduleService" />

        <!-- Receiver to handle alarms -->
        <receiver android:name=".receiver.AlarmReceiver" />
        
    </application>

</manifest>
